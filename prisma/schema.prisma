generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model categorias {
  id             Int        @id @default(autoincrement())
  nome_categoria String     @unique @db.VarChar(100)
  descricao      String?    @db.VarChar(255)
  produtos       produtos[]
}

model estoques {
  id               Int                @id @default(autoincrement())
  nome             String             @unique @db.VarChar(100)
  descricao        String?            @db.VarChar(255)
  ativo            Boolean            @default(true)
  criado_em        DateTime?          @default(now()) @db.Timestamp(6)
  produto_estoques produto_estoques[]
}

model fornecedores {
  id             Int             @id @default(autoincrement())
  nome_juridico  String          @db.VarChar(150)
  nome_comercial String?         @db.VarChar(150)
  cnpj           String          @unique @db.VarChar(14)
  telefone       String?         @db.VarChar(20)
  email          String?         @db.VarChar(150)
  cep            String          @db.VarChar(8)
  logradouro     String?         @db.VarChar(150)
  numero         String?         @db.VarChar(20)
  bairro         String?         @db.VarChar(100)
  cidade         String          @db.VarChar(100)
  uf             String          @db.VarChar(2)
  latitude       Decimal?        @db.Decimal(10, 8)
  longitude      Decimal?        @db.Decimal(11, 8)
  criado_em      DateTime?       @default(now()) @db.Timestamp(6)
  notas_fiscais  notas_fiscais[]
}

model notas_fiscais {
  id            Int          @id @default(autoincrement())
  numero_nf     String       @db.VarChar(50)
  chave_acesso  String?      @unique @db.VarChar(44)
  data_emissao  DateTime     @db.Date
  valor_total   Decimal      @default(0.00) @db.Decimal(10, 2)
  fornecedor_id Int
  criado_em     DateTime?    @default(now()) @db.Timestamp(6)
  fornecedores  fornecedores @relation(fields: [fornecedor_id], references: [id], onUpdate: NoAction, map: "fk_nf_fornecedores")
}

model produto_estoques {
  produto_id Int
  estoque_id Int
  quantidade Int      @default(0)
  estoques   estoques @relation(fields: [estoque_id], references: [id], onUpdate: NoAction, map: "fk_pe_estoque")
  produtos   produtos @relation(fields: [produto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pe_produto")

  @@id([produto_id, estoque_id])
}

model produtos {
  id               Int                @id @default(autoincrement())
  nome             String             @db.VarChar(100)
  marca            String?            @db.VarChar(50)
  tipo             String?            @db.VarChar(50)
  codigo_de_barra  String             @unique @db.VarChar(100)
  estoque_minimo   Int?               @default(0)
  categoria_id     Int
  produto_estoques produto_estoques[]
  categorias       categorias         @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoria")
}

model usuario {
  id       Int     @id @default(autoincrement())
  nome     String  @db.VarChar(100)
  email    String  @unique @db.VarChar(150)
  telefone String? @db.VarChar(20)
  senha    String  @db.VarChar(255)
}
