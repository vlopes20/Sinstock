<file path="src/common/filters/prisma-exception.filter.ts">
import {
  ArgumentsHost,
  Catch,
  ExceptionFilter,
  HttpStatus,
} from '@nestjs/common';
import { Response } from 'express';
import { Prisma } from 'generated/prisma';

@Catch(Prisma.PrismaClientKnownRequestError)
export class PrismaExceptionFilter implements ExceptionFilter {
  catch(exception: Prisma.PrismaClientKnownRequestError, host: ArgumentsHost) {
    const ctx = host.switchToHttp();
    const response = ctx.getResponse<Response>();

    let status = HttpStatus.INTERNAL_SERVER_ERROR;
    let message = 'Erro de banco de dados não tratado.';

    switch (exception.code) {
      case 'P2002': {
        status = HttpStatus.CONFLICT;
        const campos = Array.isArray(exception.meta?.target)
          ? (exception.meta?.target as string[]).join(', ')
          : 'campo único';
        message = `Conflito: Já existe um registro com o mesmo valor para: ${campos}.`;
        break;
      }

      case 'P2025': {
        status = HttpStatus.NOT_FOUND;
        message = 'O registro solicitado não foi encontrado no banco de dados.';
        break;
      }

      case 'P2003': {
        status = HttpStatus.BAD_REQUEST;
        message =
          'Operação inválida: violação de chave estrangeira ou vinculo com outros registros.';
        break;
      }

      default:
        message = `Erro de banco de dados (${exception.code}).`;
        break;
    }

    response.status(status).json({
      statusCode: status,
      message,
      codigo_erro: exception.code,
      timestamp: new Date().toISOString(),
    });
  }
}
</file>

<file path="src/common/services/excel.service.ts">
import { Injectable } from '@nestjs/common';
import * as ExcelJS from 'exceljs';

export interface ColunaExcel {
  header: string;
  key: string;
  width?: number;
  format?: string;
}

@Injectable()
export class ExcelService {
  async gerarExcel<T>(
    nomeAba: string,
    colunas: ColunaExcel[],
    dados: T[],
  ): Promise<Buffer> {
    const workbook = new ExcelJS.Workbook();
    workbook.creator = 'Sinstock ERP';
    workbook.created = new Date();

    const worksheet = workbook.addWorksheet(nomeAba);

    // Mapeia e define as colunas da tabela
    worksheet.columns = colunas.map((col) => ({
      header: col.header,
      key: col.key,
      width: col.width || 20,
    }));

    // Estilização do Cabeçalho (Linha 1)
    const headerRow = worksheet.getRow(1);
    headerRow.font = { bold: true, color: { argb: 'FFFFFF' }, size: 11 };
    headerRow.fill = {
      type: 'pattern',
      pattern: 'solid',
      fgColor: { argb: '1E293B' }, // Cor Slate-800
    };
    headerRow.alignment = { vertical: 'middle', horizontal: 'center' };
    headerRow.height = 25;

    // Inserção dos dados
    dados.forEach((item) => {
      worksheet.addRow(item);
    });

    // Formatação de linhas de dados e bordas
    worksheet.eachRow((row, rowNumber) => {
      if (rowNumber > 1) {
        row.height = 20;
        row.alignment = { vertical: 'middle', horizontal: 'left' };
        
        row.eachCell((cell) => {
          cell.border = {
            top: { style: 'thin', color: { argb: 'E2E8F0' } },
            left: { style: 'thin', color: { argb: 'E2E8F0' } },
            bottom: { style: 'thin', color: { argb: 'E2E8F0' } },
            right: { style: 'thin', color: { argb: 'E2E8F0' } },
          };
        });
      }
    });

    // Gera o ficheiro em memória (Buffer)
    const buffer = await workbook.xlsx.writeBuffer();
    return Buffer.from(buffer);
  }
}
</file>

