  tipo: TipoMovimentacao;

  @ApiProperty({ description: 'Quantidade movimentada' })
  @IsInt()
  @Min(1)
  quantidade: number;

  @ApiPropertyOptional({ description: 'Observação ou justificativa' })
  @IsOptional()
