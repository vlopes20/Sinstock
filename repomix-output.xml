  @ApiProperty({ description: 'ID da filial onde ocorre a movimentação' })
  @IsInt()
  @Min(1)
  filial_id: number;

  @ApiPropertyOptional({ description: 'ID do lote (opcional)' })
  @IsOptional()
  @IsInt()
  @Min(1)
  lote_id?: number;

  @ApiProperty({ enum: TipoMovimentacao, description: 'Tipo da movimentação' })
