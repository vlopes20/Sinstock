<file path="src/busca-global/busca-global.service.ts">
import { Injectable } from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import { BuscaGlobalDto } from './dto/busca-global.dto';

@Injectable()
export class BuscaGlobalService {
  constructor(private readonly prisma: PrismaService) {}

  async buscar(dto: BuscaGlobalDto) {
    const termo = dto.termo.trim();
    const { filial_id, limite = 10 } = dto;

    const [produtos, fornecedores, lotes, notasFiscais] = await Promise.all([
      // 1. Busca em Produtos (por nome ou código de barras)
      this.prisma.produtos.findMany({
        where: {
          OR: [
            { nome: { contains: termo } },
            { codigo_barras: { contains: termo } },
          ],
        },
        take: limite,
      }),

      // 2. Busca em Fornecedores (por nome_juridico ou cnpj)
      this.prisma.fornecedores.findMany({
        where: {
          OR: [
            { nome_juridico: { contains: termo } },
            { cnpj: { contains: termo } },
          ],
        },
        take: limite,
      }),

      // 3. Busca em Lotes (por numero_lote e relacionamento com saldos_estoque)
      this.prisma.lotes.findMany({
        where: {
          numero_lote: { contains: termo },
          ...(filial_id ? { saldos_estoque: { some: { filial_id } } } : {}),
        },
        include: {
          produtos: { select: { nome: true } },
          saldos_estoque: true,
        },
        take: limite,
      }),

      // 4. Busca em Notas Fiscais de Entrada (por numero_nf)
      this.prisma.notas_fiscais_entrada.findMany({
        where: {
          numero_nf: { contains: termo },
        },
        include: {
          fornecedores: { select: { nome_juridico: true } },
        },
        take: limite,
      }),
    ]);

    const totalResultados =
      produtos.length +
      fornecedores.length +
      lotes.length +
      notasFiscais.length;

    return {
      termo_pesquisado: termo,
      filtros: {
        filial_id: filial_id ?? 'todas',
        limite_por_categoria: limite,
      },
      total_resultados: totalResultados,
      resultados: {
        produtos: produtos.map((p) => ({
          id: p.id,
          nome: p.nome,
          codigo_barras: p.codigo_barras,
          estoque_minimo: p.estoque_minimo,
        })),
        fornecedores: fornecedores.map((f) => ({
          id: f.id,
          nome_juridico: f.nome_juridico,
          cnpj: f.cnpj,
          email: f.email,
          telefone: f.telefone,
        })),
        lotes: lotes.map((l) => {
          const quantidadeTotal = l.saldos_estoque.reduce(
            (acc, saldo) => acc + Number(saldo.quantidade ?? 0),
            0,
          );

          return {
            id: l.id,
            numero_lote: l.numero_lote,
            produto_nome: l.produtos?.nome,
            quantidade_total: quantidadeTotal,
            data_validade: l.data_validade,
          };
        }),
        notas_fiscais: notasFiscais.map((nf) => ({
          id: nf.id,
          numero_nf: nf.numero_nf,
          fornecedor_nome: nf.fornecedores?.nome_juridico,
          total: nf.total,
          status: nf.status,
          data_emissao: nf.data_emissao,
        })),
      },
    };
  }
}
</file>

<file path="src/categorias/categorias.service.ts">
import { Injectable, ConflictException, NotFoundException, BadRequestException } from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import { CreateCategoriaDto } from './dto/create-categoria.dto';
import { UpdateCategoriaDto } from './dto/update-categoria.dto';
import { Prisma } from '../../generated/prisma';

@Injectable()
export class CategoriasService {
  constructor(private readonly prisma: PrismaService) {}

  async criar(dto: CreateCategoriaDto) {
    try {
      return await this.prisma.categorias.create({
        data: dto,
      });
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {
        throw new ConflictException('Já existe uma categoria com este nome.');
      }
      throw error;
    }
  }

  async listar() {
    return this.prisma.categorias.findMany({
      orderBy: { id: 'desc' },
    });
  }

  async buscarPorId(id: number) {
    const categoria = await this.prisma.categorias.findUnique({
      where: { id },
    });

    if (!categoria) {
      throw new NotFoundException(`Categoria com ID ${id} não encontrada.`);
    }

    return categoria;
  }

  async atualizar(id: number, dto: UpdateCategoriaDto) {
    await this.buscarPorId(id); 

    try {
      return await this.prisma.categorias.update({
        where: { id },
        data: dto,
      });
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2002') {
        throw new ConflictException('Já existe uma categoria cadastrada com este nome.');
      }
      throw error;
    }
  }

  async remover(id: number) {
    await this.buscarPorId(id); 

    try {
      return await this.prisma.categorias.delete({
        where: { id },
      });
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2003') {
        throw new BadRequestException('Não é possível excluir esta categoria pois existem produtos vinculados a ela.');
      }
      throw error;
    }
  }
}
</file>

<file path="src/common/services/pdf.service.ts">
import { Injectable } from '@nestjs/common';

export type ColunaDef =
  | string
  | { header: string; key?: string; width?: number | string };

@Injectable()
export class PdfService {
  private pdfmake: any;

  constructor() {
    // eslint-disable-next-line @typescript-eslint/no-var-requires
    this.pdfmake = require('pdfmake');

    this.pdfmake.addFonts({
      Roboto: {
        normal: 'Helvetica',
        bold: 'Helvetica-Bold',
        italics: 'Helvetica-Oblique',
        bolditalics: 'Helvetica-BoldOblique',
      },
    });

    // Bloqueia recursos externos por URL.
    this.pdfmake.setUrlAccessPolicy(() => false);

    // Permite somente as fontes Helvetica utilizadas no PDF.
    this.pdfmake.setLocalAccessPolicy((path: string) =>
      [
        'Helvetica',
        'Helvetica-Bold',
        'Helvetica-Oblique',
        'Helvetica-BoldOblique',
      ].includes(path),
    );
  }

  /**
   * Gera um Buffer a partir da definição de um documento PDF.
   */
  async gerarBuffer(docDefinition: any): Promise<Buffer> {
    const pdf = this.pdfmake.createPdf(docDefinition);
    const buffer = await pdf.getBuffer();

    return Buffer.from(buffer);
  }

  /**
   * Gera um PDF formatado em tabela,
   * aceitando matrizes ou arrays de objetos.
   */
  async gerarRelatorioTabela(
    titulo: string,
    colunas: ColunaDef[],
    dados: (any[] | Record<string, any>)[],
    orientacao: 'portrait' | 'landscape' = 'portrait',
  ): Promise<Buffer> {
    const headers = colunas.map((col) =>
      typeof col === 'string' ? col : col.header,
    );

    const widths = colunas.map((col) => {
      if (
        typeof col === 'object' &&
        col.width &&
        typeof col.width === 'number'
      ) {
        return col.width;
      }

      return '*';
    });

    const linhasFormatadas: string[][] = dados.map((item) => {
      if (Array.isArray(item)) {
        return item.map((celula) =>
          celula !== null && celula !== undefined
            ? String(celula)
            : '',
        );
      }

      return colunas.map((col) => {
        const key =
          typeof col === 'object' && col.key ? col.key : null;

        const valor = key && item ? item[key] : '';

        return valor !== null && valor !== undefined
          ? String(valor)
          : '';
      });
    });

    const docDefinition = {
      pageOrientation: orientacao,
      content: [
        {
          text: titulo,
          style: 'header',
        },
        {
          text: `Emissão: ${new Date().toLocaleString('pt-PT')}`,
          style: 'subheader',
        },
        {
          text: '\n',
        },
        {
          table: {
            headerRows: 1,
            widths,
            body: [
              headers.map((h) => ({
                text: h,
                style: 'tableHeader',
              })),
              ...linhasFormatadas,
            ],
          },
          layout: 'lightHorizontalLines',
        },
      ],
      styles: {
        header: {
          fontSize: 18,
          bold: true,
          margin: [0, 0, 0, 6],
        },
        subheader: {
          fontSize: 9,
          italics: true,
          color: '#555555',
          margin: [0, 0, 0, 10],
        },
        tableHeader: {
          bold: true,
          fontSize: 10,
          fillColor: '#EEEEEE',
        },
      },
      defaultStyle: {
        font: 'Roboto',
        fontSize: 9,
      },
    };

    return this.gerarBuffer(docDefinition);
  }
}
</file>

