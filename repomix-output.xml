import {
  Injectable,
  NotFoundException,
  BadRequestException,
  ConflictException,
} from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import { CreateProdutoDto } from './dto/create-produto.dto';
import { UpdateProdutoDto } from './dto/update-produto.dto';
import { FiltroProdutosDto } from './dto/filtro-produtos.dto';
import { Prisma } from '../../generated/prisma';

@Injectable()
export class ProdutosService {
  constructor(private readonly prisma: PrismaService) {}

  async criar(dto: CreateProdutoDto) {
    try {
      return await this.prisma.produtos.create({
        data: dto,
      });
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError) {
        if (error.code === 'P2003') {
          throw new BadRequestException('A categoria informada não existe.');
        }
        if (error.code === 'P2002') {
          throw new ConflictException('Já existe um produto cadastrado com este código de barras.');
        }
      }
      throw error;
    }
  }

  async listar(dto: FiltroProdutosDto) {
    const {
      pagina = 1,
      limite = 10,
      busca,
      categoria_id,
      apenas_estoque_baixo,
      ordenar_por = 'id',
      ordem = 'desc',
    } = dto;

    const skip = (pagina - 1) * limite;

    // Cláusula WHERE dinâmica
    const where: Prisma.produtosWhereInput = {};

    if (busca) {
      where.OR = [
        { nome: { contains: busca } },
        { codigo_barras: { contains: busca } },
      ];
    }

    if (categoria_id) {
      where.categoria_id = categoria_id;
    }

    if (apenas_estoque_baixo) {
      where.saldos_estoque = {
        some: {
          quantidade: { lte: 10 },
        },
      };
    }

    // Ordenação segura
    const camposPermitidos = ['id', 'nome', 'codigo_barras', 'criado_em'];
    const campoOrdenacao = camposPermitidos.includes(ordenar_por)
      ? ordenar_por
      : 'id';

    const orderBy = { [campoOrdenacao]: ordem };

    // Consulta paralela de total e dados paginados
    const [total, dados] = await Promise.all([
      this.prisma.produtos.count({ where }),
      this.prisma.produtos.findMany({
        where,
        skip,
        take: limite,
        orderBy,
        include: {
          categorias: true,
          saldos_estoque: true,
        },
      }),
    ]);

    const totalPages = Math.ceil(total / limite);

    return {
      dados,
      meta: {
        total,
        pagina,
        limite,
        totalPages,
        hasNextPage: pagina < totalPages,
        hasPreviousPage: pagina > 1,
      },
    };
  }

  async buscarPorId(id: number) {
    const produto = await this.prisma.produtos.findUnique({
      where: { id },
      include: {
        categorias: true,
        saldos_estoque: true,
      },
    });

    if (!produto) {
      throw new NotFoundException(`Produto com ID ${id} não encontrado.`);
    }

    return produto;
  }

  async atualizar(id: number, dto: UpdateProdutoDto) {
    await this.buscarPorId(id);

    try {
      return await this.prisma.produtos.update({
        where: { id },
        data: dto,
      });
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError) {
        if (error.code === 'P2003') {
          throw new BadRequestException('A categoria informada não existe.');
        }
        if (error.code === 'P2002') {
          throw new ConflictException('Já existe um produto cadastrado com este código de barras.');
        }
      }
      throw error;
    }
  }

  async remover(id: number) {
    await this.buscarPorId(id);

    try {
      return await this.prisma.produtos.delete({
        where: { id },
      });
    } catch (error) {
      if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === 'P2003') {
        throw new BadRequestException(
          'Não é possível excluir este produto pois existem registros ou movimentações vinculadas a ele.',
        );
      }
      throw error;
    }
  }

  async buscarPorCodigoBarras(codigo: string, filialId?: number) {
    const produto = await this.prisma.produtos.findUnique({
      where: { codigo_barras: codigo },
      include: {
        categorias: {
          select: { id: true, nome: true },
        },
        saldos_estoque: {
          where: filialId ? { filial_id: filialId } : {},
          include: {
            lotes: {
              select: {
                id: true,
                numero_lote: true,
                data_validade: true,
              },
            },
          },
        },
      },
    });

    if (!produto) {
      throw new NotFoundException(
        `Produto com código de barras '${codigo}' não encontrado.`,
      );
    }

    // 1. Soma do saldo total de estoque
    const saldoTotal = produto.saldos_estoque.reduce(
      (acc, saldo) => acc + Number(saldo.quantidade ?? 0),
      0,
    );

    // 2. Trata estoque_minimo convertendo Decimal/null para number
    const estoqueMinimo = Number(produto.estoque_minimo ?? 0);

    // 3. Retorno formatado
    return {
      id: produto.id,
      nome: produto.nome,
      codigo_barras: produto.codigo_barras,
      categoria: produto.categorias?.nome ?? null,
      estoque_minimo: estoqueMinimo,
      saldo_total: saldoTotal,
      alerta_estoque_baixo: saldoTotal <= estoqueMinimo,
      lotes: produto.saldos_estoque.map((saldo) => ({
        saldo_id: saldo.id,
        filial_id: saldo.filial_id,
        lote_id: saldo.lote_id,
        numero_lote: saldo.lotes?.numero_lote,
        data_validade: saldo.lotes?.data_validade,
        quantidade: Number(saldo.quantidade ?? 0),
      })),
    };
  }
}
</file>

<file path="prisma/schema.prisma">
generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model categorias {
  id        Int        @id @default(autoincrement())
  nome      String     @unique(map: "nome") @db.VarChar(100)
  descricao String?    @db.Text
  criado_em DateTime?  @default(now()) @db.Timestamp(0)
  produtos  produtos[]
}

model fornecedores {
  id                    Int                     @id @default(autoincrement())
  nome_juridico         String                  @db.VarChar(150)
  cnpj                  String                  @unique(map: "cnpj") @db.VarChar(20)
  telefone              String?                 @db.VarChar(20)
  email                 String?                 @db.VarChar(100)
  cep                   String?                 @db.VarChar(10)
  cidade                String?                 @db.VarChar(100)
  estado                String?                 @db.Char(2)
  endereco              String?                 @db.VarChar(255)
  latitude              Decimal?                @db.Decimal(10, 8)
  longitude             Decimal?                @db.Decimal(11, 8)
  criado_em             DateTime?               @default(now()) @db.Timestamp(0)
  notas_fiscais_entrada notas_fiscais_entrada[]
}

model produtos {
  id                 Int                  @id @default(autoincrement())
  categoria_id       Int
  nome               String               @db.VarChar(150)
  marca              String?              @db.VarChar(100)
  codigo_barras      String?              @unique(map: "codigo_barras") @db.VarChar(100)
  estoque_minimo     Decimal?             @default(0.000) @db.Decimal(10, 3)
  preco_venda        Decimal              @db.Decimal(10, 2)
  custo_medio        Decimal?             @default(0.00) @db.Decimal(10, 2)
  criado_em          DateTime?            @default(now()) @db.Timestamp(0)
  atualizado_em      DateTime?            @default(now()) @db.Timestamp(0)
  itens_entrada      itens_entrada[]
  itens_venda        itens_venda[]
  logs_movimentacoes logs_movimentacoes[]
  lotes              lotes[]
  categorias         categorias           @relation(fields: [categoria_id], references: [id], onUpdate: NoAction, map: "fk_categoria")
  saldos_estoque     saldos_estoque[]

  @@index([categoria_id], map: "fk_produtos_categoria")
}

model chamados_suporte {
  id              Int                      @id @default(autoincrement())
  usuario_id      Int
  assunto         String                   @db.VarChar(150)
  descricao       String                   @db.Text
  status          chamados_suporte_status? @default(ABERTO)
  data_abertura   DateTime?                @default(now()) @db.Timestamp(0)
  data_fechamento DateTime?                @db.Timestamp(0)
  usuarios        usuarios                 @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_chamados_usuario")

  @@index([usuario_id], map: "fk_chamados_usuario")
}

model clientes {
  id            Int             @id @default(autoincrement())
  nome          String          @db.VarChar(150)
  cpf_cnpj      String?         @db.VarChar(20)
  telefone      String?         @db.VarChar(20)
  email         String?         @db.VarChar(100)
  criado_em     DateTime?       @default(now()) @db.Timestamp(0)
  pedidos_venda pedidos_venda[]
}

model faq {
  id       Int      @id @default(autoincrement())
  pergunta String   @db.VarChar(255)
  resposta String   @db.Text
  ordem    Int?     @default(0)
  ativo    Boolean? @default(true)
}

model filiais {
  id                 Int                  @id @default(autoincrement())
  nome               String               @db.VarChar(100)
  endereco           String?              @db.VarChar(255)
  criado_em          DateTime?            @default(now()) @db.Timestamp(0)
  logs_movimentacoes logs_movimentacoes[]
  pedidos_venda      pedidos_venda[]
  saldos_estoque     saldos_estoque[]
}

model itens_entrada {
  id                    Int                   @id @default(autoincrement())
  nota_fiscal_id        Int
  produto_id            Int
  lote_id               Int?
  quantidade            Decimal               @db.Decimal(10, 3)
  custo_unitario        Decimal               @db.Decimal(10, 2)
  lotes                 lotes?                @relation(fields: [lote_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_itens_entrada_lote")
  notas_fiscais_entrada notas_fiscais_entrada @relation(fields: [nota_fiscal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_itens_entrada_nf")
  produtos              produtos              @relation(fields: [produto_id], references: [id], onUpdate: NoAction, map: "fk_itens_entrada_produto")

  @@index([lote_id], map: "fk_itens_entrada_lote")
  @@index([nota_fiscal_id], map: "fk_itens_entrada_nf")
  @@index([produto_id], map: "fk_itens_entrada_produto")
}

model itens_venda {
  id             Int           @id @default(autoincrement())
  pedido_id      Int
  produto_id     Int
  lote_id        Int?
  quantidade     Decimal       @db.Decimal(10, 3)
  preco_unitario Decimal       @db.Decimal(10, 2)
  lotes          lotes?        @relation(fields: [lote_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_itens_venda_lote")
  pedidos_venda  pedidos_venda @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_itens_venda_pedido")
  produtos       produtos      @relation(fields: [produto_id], references: [id], onUpdate: NoAction, map: "fk_itens_venda_produto")

  @@index([lote_id], map: "fk_itens_venda_lote")
  @@index([pedido_id], map: "fk_itens_venda_pedido")
  @@index([produto_id], map: "fk_itens_venda_produto")
}

model logs_movimentacoes {
  id                BigInt                               @id @default(autoincrement())
  produto_id        Int
  filial_id         Int
  lote_id           Int?
  usuario_id        Int
  tipo_movimentacao logs_movimentacoes_tipo_movimentacao
  quantidade        Decimal                              @db.Decimal(10, 3)
  saldo_anterior    Decimal                              @db.Decimal(10, 3)
  saldo_atual       Decimal                              @db.Decimal(10, 3)
  origem_id         Int?
  data_hora         DateTime?                            @default(now()) @db.Timestamp(0)
  filiais           filiais                              @relation(fields: [filial_id], references: [id], onUpdate: NoAction, map: "fk_logs_filial")
  lotes             lotes?                               @relation(fields: [lote_id], references: [id], onUpdate: NoAction, map: "fk_logs_lote")
  produtos          produtos                             @relation(fields: [produto_id], references: [id], onUpdate: NoAction, map: "fk_logs_produto")
  usuarios          usuarios                             @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_logs_usuario")

  @@index([filial_id], map: "fk_logs_filial")
  @@index([lote_id], map: "fk_logs_lote")
  @@index([produto_id], map: "fk_logs_produto")
  @@index([usuario_id], map: "fk_logs_usuario")
  @@index([data_hora], map: "idx_logs_data")
}

model lotes {
  id                 Int                  @id @default(autoincrement())
  produto_id         Int
  numero_lote        String               @db.VarChar(50)
  data_fabricacao    DateTime?            @db.Date
  data_validade      DateTime             @db.Date
  criado_em          DateTime?            @default(now()) @db.Timestamp(0)
  itens_entrada      itens_entrada[]
  itens_venda        itens_venda[]
  logs_movimentacoes logs_movimentacoes[]
  produtos           produtos             @relation(fields: [produto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lotes_produto")
  saldos_estoque     saldos_estoque[]

  @@unique([produto_id, numero_lote], map: "uk_lotes_produto_numero")
}

model notas_fiscais_entrada {
  id               Int                           @id @default(autoincrement())
  fornecedor_id    Int
  usuario_id       Int
  numero_nf        String                        @db.VarChar(50)
  data_emissao     DateTime                      @db.Date
  data_recebimento DateTime?                     @default(now()) @db.Timestamp(0)
  total            Decimal                       @db.Decimal(10, 2)
  status           notas_fiscais_entrada_status? @default(RECEBIDA)
  itens_entrada    itens_entrada[]
  fornecedores     fornecedores                  @relation(fields: [fornecedor_id], references: [id], onUpdate: NoAction, map: "fk_nf_fornecedor")
  usuarios         usuarios                      @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_nf_usuario")

  @@index([fornecedor_id], map: "fk_nf_fornecedor")
  @@index([usuario_id], map: "fk_nf_usuario")
}

model pedidos_venda {
  id          Int                   @id @default(autoincrement())
  usuario_id  Int
  cliente_id  Int?
  filial_id   Int
  data_venda  DateTime?             @default(now()) @db.Timestamp(0)
  total       Decimal               @db.Decimal(10, 2)
  status      pedidos_venda_status? @default(CONCLUIDO)
  itens_venda itens_venda[]
  clientes    clientes?             @relation(fields: [cliente_id], references: [id], onUpdate: NoAction, map: "fk_pedidos_cliente")
  filiais     filiais               @relation(fields: [filial_id], references: [id], onUpdate: NoAction, map: "fk_pedidos_filial")
  usuarios    usuarios              @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_pedidos_usuario")

  @@index([cliente_id], map: "fk_pedidos_cliente")
  @@index([filial_id], map: "fk_pedidos_filial")
  @@index([usuario_id], map: "fk_pedidos_usuario")
}

model perfis {
  id         Int        @id @default(autoincrement())
  nome       String     @unique(map: "nome") @db.VarChar(50)
  permissoes Json
  criado_em  DateTime?  @default(now()) @db.Timestamp(0)
  usuarios   usuarios[]
}

model saldos_estoque {
  id            Int       @id @default(autoincrement())
  filial_id     Int
  produto_id    Int
  lote_id       Int?
  quantidade    Decimal   @default(0.000) @db.Decimal(10, 3)
  atualizado_em DateTime? @default(now()) @db.Timestamp(0)
  filiais       filiais   @relation(fields: [filial_id], references: [id], onUpdate: NoAction, map: "fk_saldos_filial")
  lotes         lotes?    @relation(fields: [lote_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_saldos_lote")
  produtos      produtos  @relation(fields: [produto_id], references: [id], onUpdate: NoAction, map: "fk_saldos_produto")

  @@unique([filial_id, produto_id, lote_id], map: "uk_saldos_filial_produto_lote")
  @@index([lote_id], map: "fk_saldos_lote")
  @@index([produto_id], map: "fk_saldos_produto")
}

model usuarios {
  id                    Int                     @id @default(autoincrement())
  perfil_id             Int
  nome                  String                  @db.VarChar(100)
  email                 String                  @unique(map: "email") @db.VarChar(100)
  telefone              String?                 @db.VarChar(20)
  senha_hash            String                  @db.VarChar(255)
  token_2fa             String?                 @db.VarChar(100)
  token_expiracao       DateTime?               @db.DateTime(0)
  
  twoFactorSecret       String?                 @map("two_factor_secret") @db.VarChar(255)
  isTwoFactorEnable     Boolean                 @default(false) @map("is_two_factor_enabled")

  ativo                 Boolean?                @default(true)
  criado_em             DateTime?               @default(now()) @db.Timestamp(0)
  atualizado_em         DateTime?               @default(now()) @db.Timestamp(0)

  chamados_suporte      chamados_suporte[]
  logs_movimentacoes    logs_movimentacoes[]
  notas_fiscais_entrada notas_fiscais_entrada[]
  pedidos_venda         pedidos_venda[]
  perfis                perfis                  @relation(fields: [perfil_id], references: [id], onUpdate: NoAction, map: "fk_usuarios_perfil")

  @@index([perfil_id], map: "fk_usuarios_perfil")
}

model notificacoes {
  id        Int      @id @default(autoincrement())
  titulo    String
  mensagem  String
  tipo      String
  lida      Boolean  @default(false)
  criado_em DateTime @default(now())
}

enum chamados_suporte_status {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  FECHADO
}

enum logs_movimentacoes_tipo_movimentacao {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  AJUSTE
}

enum pedidos_venda_status {
  ORCAMENTO
  CONCLUIDO
  CANCELADO
}

enum notas_fiscais_entrada_status {
  PENDENTE
  RECEBIDA
  CANCELADA
}
</file>

