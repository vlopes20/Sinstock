# Aplicação
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:3000/frontend/

# Rate Limit (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Base de Dados MySQL
DATABASE_URL="mysql://root:sua_senha@localhost:3306/sinstock"
JWT_SECRET=substitua_por_um_segredo_aleatorio_longo

# Configurações de E-mail (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Senha de app do Google (16 caracteres, sem os espacos de exibicao).
SMTP_PASS=
# Use o mesmo email de SMTP_USER: "Sinstock ERP <seuemail@gmail.com>"
SMTP_FROM=

# Contato exibido na tela Ajuda (opcional; usa o e-mail da empresa como alternativa).
SUPPORT_EMAIL=
# Provedor de geocodificação. Consultas ao provedor público são limitadas e armazenadas em cache.
NOMINATIM_URL=https://nominatim.openstreetmap.org
